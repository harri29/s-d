{
  "name": "to-mong-hac-nap-trailer",
  "version": "1.0.0",
  "private": true,
  "description": "Trailer gioi thieu Lam Thuong Khung - To Mong Hac Nap, rendered with Remotion on GitHub Actions.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts TMMN-Trailer out/to-mong-hac-nap-trailer.mp4 --codec=h264",
    "render:preview": "remotion render src/index.ts TMMN-Trailer-Preview out/trailer-preview.mp4 --codec=h264",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.468",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.468"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.8.3"
  }
}
